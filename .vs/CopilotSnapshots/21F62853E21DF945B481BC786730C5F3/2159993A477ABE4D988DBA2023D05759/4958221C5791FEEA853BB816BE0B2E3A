using Xunit;
using Assert = Xunit.Assert;
using SmartX.Shared.Models;
using SmartX.Shared.Services;

namespace SmartX.Tests;

public class SmartXEngineTests
{
    [Fact]
    public void Test_JaggedArrayFlattener_FlattensWithoutLoss()
    {
        var processor = new TelemetryBatchProcessor();
        int[][] rawBatches = new int[][]
        {
            new int[] { 100, 105 },
            new int[] { 110, 115, 120 }
        };
        string[] macs = new[] { "MAC1", "MAC2" };

        var result = processor.ProcessJaggedBatch(rawBatches, macs);

        Assert.Equal(5, result.Count);
        Assert.Equal(100, result[0].Payload);
        Assert.Equal("MAC1", result[0].DeviceMac);
    }

    [Fact]
    public void Test_RecursiveTopologyValidation_DetectsMisconfiguration()
    {
        var root = new DeploymentNode
        {
            NodeId = "Facility A",
            IsSecurelyConfigured = true,
            SubNodes = new()
            {
                new DeploymentNode
                {
                    NodeId = "Zone 1",
                    IsSecurelyConfigured = true,
                    SubNodes = new()
                    {
                        new DeploymentNode { NodeId = "Sub-Zone B", IsSecurelyConfigured = false } // Flawed node
                    }
                }
            }
        };

        Assert.False(root.ValidateTopology());
    }

    [Fact]
    public void Test_OperatorOverloading_AggregatesTruckTelemetry()
    {
        var truck1 = new TruckTelemetry { TruckId = "TRK-01", DistanceTraveledKm = 150.0, FuelLevelLiters = 40.0f };
        var truck2 = new TruckTelemetry { TruckId = "TRK-02", DistanceTraveledKm = 200.0, FuelLevelLiters = 50.0f };

        var combined = truck1 + truck2;

        Assert.Equal(350.0, combined.DistanceTraveledKm);
        Assert.Equal(90.0f, combined.FuelLevelLiters);
    }

    [Fact]
    public void Test_TruckRouteSimulator_GeneratesHourlySamplesBetweenRouteEndpoints()
    {
        var fleet = new[]
        {
            new TruckTelemetry { TruckId = "TRK-001", Latitude = -29.8587, Longitude = 31.0218 },
            new TruckTelemetry { TruckId = "TRK-002", Latitude = -26.2041, Longitude = 28.0473 }
        };
        var currentTime = new DateTime(2026, 6, 1, 12, 34, 0, DateTimeKind.Utc);

        var samples = TruckRouteSimulator.GenerateHourlySamples(fleet, currentTime);

        Assert.Equal(26, samples.Count);
        var firstTruckSamples = samples.Where(sample => sample.Payload.TruckId == "TRK-001").ToArray();
        Assert.Equal(13, firstTruckSamples.Length);
        Assert.Equal(currentTime.AddHours(-12).AddMinutes(-34), firstTruckSamples[0].Timestamp);
        Assert.Equal(-29.8587, firstTruckSamples[^1].Payload.Latitude, 4);
        Assert.Equal(31.0218, firstTruckSamples[^1].Payload.Longitude, 4);
        Assert.NotEqual(firstTruckSamples[0].Payload.Latitude, firstTruckSamples[^1].Payload.Latitude);
        Assert.All(firstTruckSamples.Zip(firstTruckSamples.Skip(1)), pair =>
            Assert.Equal(TimeSpan.FromHours(1), pair.Second.Timestamp - pair.First.Timestamp));
    }

    [Fact]
    public void Test_TruckRouteSimulator_CoversEveryFleetTruckWithGpsCoordinates()
    {
        var fleet = Enumerable.Range(1, 12)
            .Select(number => new TruckTelemetry { TruckId = $"TRK-{number:000}" })
            .ToArray();

        var samples = TruckRouteSimulator.GenerateHourlySamples(fleet);

        Assert.Equal(12 * 13, samples.Count);
        Assert.Equal(12, samples.Select(sample => sample.Payload.TruckId).Distinct().Count());
        Assert.All(samples, sample =>
        {
            Assert.InRange(sample.Payload.Latitude, -90, 90);
            Assert.InRange(sample.Payload.Longitude, -180, 180);
            Assert.False(string.IsNullOrWhiteSpace(sample.DeviceMac));
        });
    }

    [Fact]
    public void Test_EmergencyAlertQueue_PrioritizesCriticalAlertsBeforeHighAlerts()
    {
        var queue = new EmergencyAlertQueue();
        var timestamp = new DateTime(2026, 6, 1, 12, 0, 0, DateTimeKind.Utc);

        queue.ProcessTelemetry(CreateTelemetryPacket(new TruckTelemetry
        {
            TruckId = "TRK-FUEL",
            FuelLevelLiters = 80
        }, timestamp.AddMinutes(5)));
        queue.ProcessTelemetry(CreateTelemetryPacket(new TruckTelemetry
        {
            TruckId = "TRK-TYRE",
            TyrePressureLow = true
        }, timestamp));

        var alerts = queue.GetActiveAlerts();

        Assert.Equal(2, alerts.Count);
        Assert.Equal("TRK-TYRE", alerts[0].TruckId);
        Assert.Equal(FleetAlertSeverity.Critical, alerts[0].Severity);
        Assert.Equal("TRK-FUEL", alerts[1].TruckId);
        Assert.Equal(FleetAlertSeverity.High, alerts[1].Severity);
    }

    [Fact]
    public void Test_EmergencyAlertQueue_DeduplicatesAlertsAndClearsOnRecovery()
    {
        var queue = new EmergencyAlertQueue();
        var firstReadingAt = new DateTime(2026, 6, 1, 12, 0, 0, DateTimeKind.Utc);

        queue.ProcessTelemetry(CreateTelemetryPacket(new TruckTelemetry
        {
            TruckId = "TRK-OIL",
            OilLevelLow = true
        }, firstReadingAt));
        queue.ProcessTelemetry(CreateTelemetryPacket(new TruckTelemetry
        {
            TruckId = "TRK-OIL",
            OilLevelLow = true
        }, firstReadingAt.AddHours(1)));

        var activeAlerts = queue.GetActiveAlerts();
        Assert.Single(activeAlerts);
        Assert.Equal(firstReadingAt, activeAlerts[0].FirstRaisedAt);
        Assert.Equal(firstReadingAt.AddHours(1), activeAlerts[0].LastUpdatedAt);

        queue.ProcessTelemetry(CreateTelemetryPacket(new TruckTelemetry
        {
            TruckId = "TRK-OIL",
            OilLevelLow = false
        }, firstReadingAt.AddHours(2)));

        Assert.Empty(queue.GetActiveAlerts());
    }

    private static TelemetryPacket<TruckTelemetry> CreateTelemetryPacket(TruckTelemetry telemetry, DateTime timestamp) =>
        new("TEST-MAC", telemetry) { Timestamp = timestamp };
}