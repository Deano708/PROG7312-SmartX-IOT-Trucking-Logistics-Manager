<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SmartX.Client</title>
    <base href="/" />
    <link rel="preload" id="webassembly" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link href="SmartX.Client.styles.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script type="importmap"></script>
</head>

<body>
    <div id="app">
        <svg class="loading-progress">
            <circle r="40%" cx="50%" cy="50%" />
            <circle r="40%" cx="50%" cy="50%" />
        </svg>
        <div class="loading-progress-text"></div>
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
    <script src="_framework/blazor.webassembly#[.{fingerprint}].js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
            var mapInstances = {};

            function updateFleetMap(elementId, lat, lng, truckId, driverName, hoursAgo) {
                var container = document.getElementById(elementId);
                if (!container) return;

                // Reset stale Leaflet instance if Blazor recreated the DOM container
                if (mapInstances[elementId]) {
                    if (mapInstances[elementId].getContainer() !== container) {
                        mapInstances[elementId].remove();
                        delete mapInstances[elementId];
                    }
                }

                // Initialize new Leaflet instance on the current DOM container
                if (!mapInstances[elementId]) {
                    mapInstances[elementId] = L.map(elementId).setView([lat, lng], 10);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 18,
                        attribution: '© OpenStreetMap'
                    }).addTo(mapInstances[elementId]);
                    mapInstances[elementId].marker = L.marker([lat, lng]).addTo(mapInstances[elementId]);
                } else {
                    mapInstances[elementId].setView([lat, lng], mapInstances[elementId].getZoom());
                    mapInstances[elementId].marker.setLatLng([lat, lng]);
                }

                // Force Leaflet to recalculate container dimensions upon page navigation
                setTimeout(function () {
                    if (mapInstances[elementId]) {
                        mapInstances[elementId].invalidateSize();
                    }
                }, 100);

                var statusText = hoursAgo === 0 ? "LIVE LOCATION" : hoursAgo + " hrs ago";
                mapInstances[elementId].marker.bindPopup(
                    "<b>" + truckId + " (" + driverName + ")</b><br/>Status: " + statusText + "<br/>Lat: " + lat.toFixed(4) + ", Lng: " + lng.toFixed(4)
                ).openPopup();
            }
    </script>
</body>

</html>
