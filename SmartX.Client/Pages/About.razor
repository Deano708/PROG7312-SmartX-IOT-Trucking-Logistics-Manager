@page "/about"

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="fw-bold text-primary mb-3">About Smart-X Trucking</h1>
            <p class="lead text-muted">
                Smart-X is a fleet logistics demonstration for monitoring truck telemetry and connected sensors.
            </p>
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">What you can do</h2>
                    <ul class="mb-4">
                        <li>Review fleet status and simulated GPS routes.</li>
                        <li>Monitor fuel, oil, tyre pressure, and emergency alerts.</li>
                        <li>Manage sensor assignments for fleet vehicles.</li>
                    </ul>
                    <a class="btn btn-primary" href="/dashboard">Open Fleet Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
