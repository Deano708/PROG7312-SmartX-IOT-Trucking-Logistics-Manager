@page "/"
@implements IDisposable
@using SmartX.Client.Services
@inject CommandHistoryService CommandHistory
@inject NavigationManager NavigationManager

<PageTitle>Gateway | Smart-X Trucking</PageTitle>

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="display-4 fw-bold text-primary">Smart-X: Trucking Gateway</h1>
        <p class="lead text-muted">IoT logistics and fleet management for KZN transport corridors</p>
    </div>

    <section class="card border-0 shadow-sm mb-5" aria-labelledby="aboutSmartXTitle">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4">
                <div class="col-12">
                    <span class="badge bg-primary mb-2">About the application</span>
                    <h2 class="h3 fw-bold" id="aboutSmartXTitle">Fleet telemetry, alerts, and predictive insights</h2>
                    <p class="text-secondary mb-0">
                        Smart-X is a fleet-management demonstration that brings simulated truck telemetry and connected sensor status into one place.
                        Use the workspaces below to manage sensor assignments, monitor vehicle health and emergency alerts, and explore the application’s data and prediction features.
                    </p>
                </div>
                <div class="col-lg-6">
                    <div class="h-100 p-3 bg-light rounded">
                        <h3 class="h5 fw-bold"><i class="bi bi-diagram-3 me-2 text-primary"></i>Data structures in use</h3>
                        <ul class="mb-0 ps-3">
                            <li class="mb-2"><strong>Dictionary:</strong> maps a truck ID to its telemetry for direct lookups; the dashboard also groups active alert counts by truck ID.</li>
                            <li class="mb-2"><strong>Priority queue:</strong> orders active dispatch alerts so critical risks appear before lower-severity alerts, with truck ID used to break ties.</li>
                            <li class="mb-2"><strong>Hash set:</strong> tracks unique disconnected sensor nodes and detected alert types, helping avoid duplicate alerts and identify recovered conditions.</li>
                            <li><strong>Concurrent dictionary:</strong> stores telemetry history by truck and timestamp, supporting safe access while the server ingests readings.</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="h-100 p-3 bg-light rounded">
                        <h3 class="h5 fw-bold"><i class="bi bi-cpu me-2 text-success"></i>ML.NET fuel-range prediction</h3>
                        <p class="text-secondary">
                            ML.NET is Microsoft’s machine-learning framework for .NET. Smart-X trains a FastTree regression model when the server starts, using generated examples of speed, fuel level, and payload weight paired with estimated remaining-range labels.
                        </p>
                        <p class="text-secondary mb-0">
                            When a truck’s range is requested, those three telemetry values are passed to the trained model to estimate remaining kilometres. Stationary trucks and trucks with no fuel are handled explicitly as a 0 km range. This demonstration uses synthetic training data, not calibrated vehicle fuel measurements. Note: All trucks are assumed to be Volvo FH440 with 15 , 24 & 32 tonne payloads.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="text-center mb-3">
        <h2 class="h3 fw-bold">Choose a workspace</h2>
        <p class="text-muted mb-0">Select one of the three application areas to continue.</p>
    </div>

    <!-- Three Architectural Pillars -->
    <div class="row g-4 mb-5">
        <!-- Pillar 1: Active -->
        <div class="col-md-4">
            <div class="card h-100 border-success shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">Active</span>
                    <h5 class="card-title">1. Telemetry Ingestion</h5>
                    <p class="card-text text-secondary">
                        Assign Sensors (Fuel & Fluids, GPS & Telemetry , Structural & Safety) and check active sensor list.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/truck-sensors" class="btn btn-outline-success w-100">Truck Sensors</a>
                </div>
            </div>
        </div>

        <!-- Pillar 2: Active -->
        <div class="col-md-4">
            <div class="card h-100 border-primary shadow-sm">
                <div class="card-body">
                    <span class="badge bg-primary mb-2">Active </span>
                    <h5 class="card-title">2. Real-Time Command Stream </h5>
                    <p class="card-text text-secondary">
                        Live dynamic dashboard delivering speed metrics, hourly GSP reports, and current truck operational condition and emergency alerts with the inclusion of a predictive range recommendation.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/dashboard" class="btn btn-outline-primary w-100">Monitor Dashboard</a>
                </div>
            </div>
        </div>

        <!-- Pillar 3: Disabled / Future -->
        <div class="col-md-4">
            <div class="card h-100 border-secondary bg-light opacity-75">
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">Disabled / In Development</span>
                    <h5 class="card-title text-muted">3. History & Mesh Routing</h5>
                    <p class="card-text text-muted">
                        Historical batch archive analytics and decentralized vehicle-to-vehicle mesh network topology routing. (TO BE EXPANDED IN FINAL PART)
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <button class="btn btn-secondary w-100" disabled>Coming Soon</button>
                </div>
            </div>
        </div>
    </div>

    <section class="card border-0 shadow-sm mb-4" aria-labelledby="commandHistoryTitle">
        <div class="card-header bg-dark text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 class="h5 fw-bold mb-0" id="commandHistoryTitle"><i class="bi bi-clock-history me-2"></i>Command history</h2>
                <div class="small">Recent workspace visits and fleet filter actions, newest first. Select an entry to return to its workspace.</div>
            </div>
            <button class="btn btn-sm btn-outline-light" @onclick="ClearCommandHistory" disabled="@(recentCommands.Count == 0)">Clear history</button>
        </div>
        <div class="card-body">
            @if (recentCommands.Count == 0)
            {
                <p class="text-muted mb-0">No commands recorded yet. Visit a workspace or apply fleet filters to begin.</p>
            }
            else
            {
                <ol class="list-group list-group-numbered">
                    @foreach (var command in recentCommands)
                    {
                        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <button class="btn btn-link text-start p-0" @onclick="() => OpenCommandDestination(command)">@command.Command</button>
                            <time class="small text-muted" datetime="@command.ExecutedAtUtc.ToString("O")">@command.ExecutedAtUtc.ToLocalTime().ToString("g")</time>
                        </li>
                    }
                </ol>
            }
            <div class="small text-muted mt-2">History uses a stack and keeps the latest 50 commands for this app session.</div>
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<CommandHistoryEntry> recentCommands = Array.Empty<CommandHistoryEntry>();

    protected override void OnInitialized()
    {
        RefreshCommandHistory();
        CommandHistory.Changed += OnCommandHistoryChanged;
    }

    private void OnCommandHistoryChanged() => _ = InvokeAsync(() =>
    {
        RefreshCommandHistory();
        StateHasChanged();
    });

    private void RefreshCommandHistory() => recentCommands = CommandHistory.GetRecentCommands();

    private void OpenCommandDestination(CommandHistoryEntry command) => NavigationManager.NavigateTo(command.TargetPath);

    private void ClearCommandHistory()
    {
        CommandHistory.Clear();
        RefreshCommandHistory();
    }

    public void Dispose() => CommandHistory.Changed -= OnCommandHistoryChanged;
}