@page "/truck-sensors"
@page "/sensors"
@using SmartX.Shared.Models
@using SmartX.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@inject TruckSensorStateService SensorService

@* //DELCARATION OF AI USAGE
//Gemini. (2026) . Setup of TruckSensorManagement page. Available at: 
//https://share.gemini.google/O9Qf6fnMtm4B (Accessed: 14/09/2026). *@


<div class="container py-4">
    <h3 class="fw-bold mb-3">Vehicle Sensor Payload Configuration</h3>
    <p class="text-muted mb-4">Register hardware nodes, assign specific sensors, and attach calibration spec sheets across all 12 fleet vehicles.</p>

    <div class="row g-4">
        <!-- Sensor Registration Form -->
        <div class="col-md-6">
            <div class="card p-4 shadow-sm border-0 bg-white">
                <h5 class="card-title mb-3">Attach Sensor to Vehicle</h5>
                <EditForm Model="sensorModel" OnValidSubmit="RegisterSensor">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Target Truck (12 Vehicles)</label>
                        <select class="form-select" @bind="sensorModel.AssignedTruckId">
                            @foreach (var truck in SensorService.Fleet)
                            {
                                <option value="@truck.TruckId">@truck.TruckId — @truck.DriverName (@truck.NearestTown.Split('(')[0].Trim())</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hardware MAC / Identifier</label>
                        <input type="text" class="form-control" @bind="sensorModel.DeviceMac" placeholder="24:6F:28:AB:C1:10" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Sensor Category</label>
                        <select class="form-select" value="@sensorModel.Category" @onchange="OnCategoryChanged">
                            <option value="@TruckSensorCategory.FuelAndFluids">Fuel & Fluids</option>
                            <option value="@TruckSensorCategory.GpsAndTelemetry">GPS & Telemetry</option>
                            <option value="@TruckSensorCategory.StructuralAndSafety">Structural & Safety</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Assign Sensor</label>
                        <select class="form-select" @bind="sensorModel.AssignedSensorName">
                            @foreach (var option in GetSensorOptions(sensorModel.Category))
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Attach Calibration / Specification File</label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" accept=".pdf,.txt,.json,.csv,.png,.jpg" />
                        @if (isUploading)
                        {
                            <div class="small text-primary mt-1">Processing file binary...</div>
                        }
                    </div>

                    <button type="submit" class="btn btn-primary w-100" disabled="@isUploading">Attach Sensor Payload</button>
                </EditForm>
            </div>
        </div>

        <!-- Active Fleet Sensor Registry -->
        <div class="col-md-6">
            <div class="card p-4 shadow-sm border-0 bg-white">
                <h5 class="card-title mb-3">Assigned Vehicle Sensors (@SensorService.Sensors.Count)</h5>
                @if (SensorService.Sensors.Any())
                {
                    <div class="list-group style-scroll" style="max-height: 520px; overflow-y: auto;">
                        @foreach (var sensor in SensorService.Sensors)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-dark me-2">@sensor.AssignedTruckId</span>
                                    <span class="badge bg-secondary me-2">@GetCategoryDisplayName(sensor.Category)</span>
                                    <strong>@sensor.AssignedSensorName</strong>
                                    <div class="small text-muted mt-1">
                                        MAC: <code>@sensor.DeviceMac</code>
                                    </div>
                                    @if (!string.IsNullOrEmpty(sensor.SpecSheetFileName))
                                    {
                                        <div class="mt-2 d-flex align-items-center gap-2">
                                            <span class="small text-success fw-bold">File: @sensor.SpecSheetFileName</span>
                                            @if (sensor.FileData != null && sensor.FileData.Length > 0)
                                            {
                                                <a class="btn btn-sm btn-outline-primary py-0 px-2"
                                                   style="font-size: 0.75rem;"
                                                   href="@GetFileDownloadUrl(sensor)"
                                                   download="@sensor.SpecSheetFileName"
                                                   target="_blank">
                                                    View / Download
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => SensorService.RemoveSensor(sensor)">Remove</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No sensors currently mapped to fleet vehicles.</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private TruckSensorProfile sensorModel = new();
    private bool isUploading = false;

    protected override void OnInitialized()
    {
        sensorModel.AssignedTruckId = SensorService.Fleet.FirstOrDefault().TruckId;
        sensorModel.Category = TruckSensorCategory.FuelAndFluids;
        sensorModel.AssignedSensorName = GetSensorOptions(TruckSensorCategory.FuelAndFluids).First();
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<TruckSensorCategory>(e.Value?.ToString(), out var newCategory))
        {
            sensorModel.Category = newCategory;
            var availableOptions = GetSensorOptions(newCategory);
            sensorModel.AssignedSensorName = availableOptions.FirstOrDefault() ?? string.Empty;
        }
    }

    private List<string> GetSensorOptions(TruckSensorCategory category) => category switch
    {
        TruckSensorCategory.FuelAndFluids => new List<string> { "(FLS) Fuel Level Sensor", "Engine Oil Level Sensor" },
        TruckSensorCategory.GpsAndTelemetry => new List<string> { "GPS Transponder", "ESP 32 Connectivity Microcontroller" },
        TruckSensorCategory.StructuralAndSafety => new List<string> { "Tire Pressure Monitoring System (TPMS)" },
        _ => new List<string>()
    };

    private string GetCategoryDisplayName(TruckSensorCategory category) => category switch
    {
        TruckSensorCategory.FuelAndFluids => "Fuel & Fluids",
        TruckSensorCategory.GpsAndTelemetry => "GPS & Telemetry",
        TruckSensorCategory.StructuralAndSafety => "Structural & Safety",
        _ => category.ToString()
    };

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            isUploading = true;
            try
            {
                // Max size set to 10MB
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);

                sensorModel.SpecSheetFileName = file.Name;
                sensorModel.FileData = memoryStream.ToArray();
                sensorModel.FileContentType = file.ContentType;
            }
            finally
            {
                isUploading = false;
            }
        }
    }

    private string GetFileDownloadUrl(TruckSensorProfile sensor)
    {
        if (sensor.FileData == null || sensor.FileData.Length == 0) return "#";
        var base64 = Convert.ToBase64String(sensor.FileData);
        var contentType = string.IsNullOrEmpty(sensor.FileContentType) ? "application/octet-stream" : sensor.FileContentType;
        return $"data:{contentType};base64,{base64}";
    }

    private void RegisterSensor()
    {
        SensorService.AddSensor(new TruckSensorProfile
        {
            AssignedTruckId = sensorModel.AssignedTruckId,
            DeviceMac = sensorModel.DeviceMac,
            Category = sensorModel.Category,
            AssignedSensorName = sensorModel.AssignedSensorName,
            SpecSheetFileName = sensorModel.SpecSheetFileName,
            FileData = sensorModel.FileData,
            FileContentType = sensorModel.FileContentType
        });

        // Reset inputs
        sensorModel.DeviceMac = string.Empty;
        sensorModel.SpecSheetFileName = string.Empty;
        sensorModel.FileData = null;
        sensorModel.FileContentType = null;
    }
}