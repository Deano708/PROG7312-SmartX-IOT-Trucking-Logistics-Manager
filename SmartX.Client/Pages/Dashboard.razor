@page "/dashboard"
@using SmartX.Shared.Services
@using SmartX.Shared.Models
@inject KznDataSeeder Seeder
@inject IJSRuntime JS

<div class="container py-4">
    <h3 class="fw-bold mb-3">Live Fleet Telemetry & GPS Monitor</h3>
    <p class="text-muted mb-4">Monitor real-time status and playback 12-hour corridor routes for all 12 vehicles across South Africa.</p>

    <!-- Vehicle & Time Selection Controls -->
    <div class="card p-4 shadow-sm border-0 mb-4 bg-white">
        <div class="row g-3 align-items-center mb-3">
            <div class="col-md-5">
                <label class="form-label fw-bold">Select Fleet Vehicle (12 Active)</label>
                <select class="form-select" @onchange="OnTruckChanged">
                    @foreach (var truckKey in Seeder.FleetJourneys.Keys)
                    {
                        var firstPoint = Seeder.FleetJourneys[truckKey][0].Payload;
                        <option value="@truckKey" selected="@(truckKey == selectedTruckId)">
                            @firstPoint.TruckId — @firstPoint.DriverName (@firstPoint.NearestTown.Split('-')[0].Trim())
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-7">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-bold mb-0">12-Hour Journey Timeline</label>
                    <span class="badge bg-dark">Hour @(selectedHourIndex + 1) of 12 (@currentPoint.Timestamp.ToShortTimeString())</span>
                </div>
                <input type="range" class="form-range" min="0" max="11" step="1"
                       value="@selectedHourIndex" @oninput="OnHourSliderInput" />
            </div>
        </div>

        <!-- Metric Telemetry Cards -->
        <div class="row g-3 text-center">
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <div class="small text-muted">Vehicle Speed</div>
                    <div class="fs-4 fw-bold text-primary">@currentPoint.Payload.SpeedKmh km/h</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <div class="small text-muted">Distance Traveled</div>
                    <div class="fs-4 fw-bold text-success">@currentPoint.Payload.DistanceTraveledKm km</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <div class="small text-muted">Remaining Fuel</div>
                    <div class="fs-4 fw-bold text-warning">@currentPoint.Payload.FuelLevelLiters L</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <div class="small text-muted">Coordinates</div>
                    <div class="small fw-bold mt-1 text-dark">
                        @currentPoint.Payload.Latitude.ToString("F4"), @currentPoint.Payload.Longitude.ToString("F4")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Map Container (Underneath Time Controls) -->
    <div class="card p-3 shadow-sm border-0 bg-white">
        <h5 class="fw-bold mb-2">Live Corridor GPS Position</h5>
        <p class="small text-muted mb-3">
            Location: <strong>@currentPoint.Payload.NearestTown</strong>
        </p>
        <div id="truckMapContainer" style="height: 420px; width: 100%;" class="rounded border"></div>
    </div>
</div>

@code {
    private string selectedTruckId = "TRK-001";
    private int selectedHourIndex = 0;
    private TelemetryPacket<TruckTelemetry> currentPoint;

    protected override void OnInitialized()
    {
        UpdateCurrentPoint();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await RenderMapLocation();
    }

    private async Task OnTruckChanged(ChangeEventArgs e)
    {
        selectedTruckId = e.Value?.ToString() ?? "TRK-001";
        UpdateCurrentPoint();
        await RenderMapLocation();
    }

    private async Task OnHourSliderInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newIndex))
        {
            selectedHourIndex = newIndex;
            UpdateCurrentPoint();
            await RenderMapLocation();
        }
    }

    private void UpdateCurrentPoint()
    {
        if (Seeder.FleetJourneys.TryGetValue(selectedTruckId, out var history))
        {
            currentPoint = history[selectedHourIndex];
        }
    }

    private async Task RenderMapLocation()
    {
        if (currentPoint.Payload.TruckId != null)
        {
            var popupLabel = $"{currentPoint.Payload.TruckId} ({currentPoint.Payload.DriverName})<br>Hour {selectedHourIndex + 1}: {currentPoint.Payload.SpeedKmh} km/h";
            await JS.InvokeVoidAsync("renderTruckMap", currentPoint.Payload.Latitude, currentPoint.Payload.Longitude, popupLabel);
        }
    }
}