@page "/dashboard"
@implements IAsyncDisposable
@using SmartX.Shared.Models
@using SmartX.Client.Services
@using SmartX.Shared.Services
@inject TruckSensorStateService SensorService
@inject SmartXApiClient ApiClient
@inject IJSRuntime JSRuntime

 @*//DELCARATION OF AI USAGE
//Gemini. (2026) . Setup of initial dashboard. Available at: 
//https://share.gemini.google/O9Qf6fnMtm4B (Accessed: 14/09/2026). 
STILL UNDER DEVELOPMENT AND ONLY SHOWING DUMMY DATA *@



<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Live Fleet Telemetry Dashboard</h2>
            <p class="text-muted mb-0">Real-time telemetry monitor with prioritized sensor visual hierarchy.</p>
        </div>
        <!-- Truck Selection Dropdown -->
        <div class="d-flex align-items-center gap-2">
            <label class="fw-bold text-nowrap">Active Truck:</label>
            <select class="form-select form-select-lg shadow-sm fw-bold border-primary" value="@selectedTruckId" @onchange="OnTruckSelected">
                @foreach (var truck in SensorService.Fleet)
                {
                    <option value="@truck.TruckId">@truck.TruckId — @truck.DriverName (@truck.NearestTown.Split('(')[0].Trim())</option>
                }
            </select>
        </div>
    </div>

    <div class="card border-danger shadow-sm mb-4">
        <div class="card-header bg-danger text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Emergency Dispatch Feed</h5>
                <div class="small">Active vehicle risks, ordered by severity and recency</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-danger fs-6">@emergencyAlerts.Count active</span>
                <button type="button" class="btn btn-sm btn-light text-danger fw-bold" aria-expanded="@isEmergencyFeedExpanded" aria-controls="emergencyDispatchFeedBody" @onclick="ToggleEmergencyFeed">
                    @(isEmergencyFeedExpanded ? "Collapse" : "Expand")
                    <i class="bi @(isEmergencyFeedExpanded ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i>
                </button>
            </div>
        </div>
        @if (isEmergencyFeedExpanded)
        {
            <div class="card-body" id="emergencyDispatchFeedBody">
                @if (!string.IsNullOrEmpty(alertFeedError))
                {
                    <div class="alert alert-warning mb-3" role="alert">@alertFeedError</div>
                }

                @if (emergencyAlerts.Count == 0)
                {
                    <div class="text-muted">No active emergency alerts. This feed checks the telemetry API every five seconds.</div>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var alert in emergencyAlerts)
                        {
                            <div class="list-group-item border-start border-4 @(alert.Severity == FleetAlertSeverity.Critical ? "border-danger" : "border-warning")">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="badge @(alert.Severity == FleetAlertSeverity.Critical ? "bg-danger" : "bg-warning text-dark")">@alert.Severity</span>
                                            <span class="badge bg-dark">@alert.TruckId</span>
                                            <strong>@GetAlertTypeDisplay(alert.Type) — @alert.DriverName</strong>
                                        </div>
                                        <div class="mt-2">@alert.Message</div>
                                        <div class="small text-muted mt-1">First raised: @alert.FirstRaisedAt.ToLocalTime().ToString("g")</div>
                                    </div>
                                    <button class="btn btn-outline-danger" @onclick="() => GoToTruckAsync(alert.TruckId)">Dispatch / View Truck</button>
                                </div>
                            </div>
                    }
                    </div>
                }
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h5 class="fw-bold mb-1">Fleet Health Filters</h5>
                    <p class="text-muted mb-0">Combine fuel, oil, and tyre states to find trucks that need attention.</p>
                </div>
                <span class="badge bg-primary fs-6">@GetFilteredTrucks().Count matching</span>
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold" for="fuelFilter">Remaining fuel</label>
                    <select id="fuelFilter" class="form-select" @bind="fuelFilter">
                        <option value="Any">Any state</option>
                        <option value="Optimal">Optimal (&gt; 300 L)</option>
                        <option value="Moderate">Moderate (101–300 L)</option>
                        <option value="Low">Low (≤ 100 L)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold" for="oilFilter">Oil level</label>
                    <select id="oilFilter" class="form-select" @bind="oilFilter">
                        <option value="Any">Any state</option>
                        <option value="Correct">Correct</option>
                        <option value="Low">Low</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold" for="tyreFilter">Tyre pressure</label>
                    <select id="tyreFilter" class="form-select" @bind="tyreFilter">
                        <option value="Any">Any state</option>
                        <option value="Correct">Correct</option>
                        <option value="Low">Low</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1" @onclick="ShowFilteredTrucks">Show trucks</button>
                    <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                </div>
            </div>
        </div>
    </div>

    @if (showFilterResults)
    {
        var filteredTrucks = GetFilteredTrucks();
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="truckFilterResultsTitle" style="background-color: rgba(0, 0, 0, 0.5);" @onclick="CloseFilterResults">
            <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable" role="document" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title fw-bold" id="truckFilterResultsTitle">Matching trucks</h5>
                            <div class="small text-muted">@filteredTrucks.Count truck(s) match the selected health filters.</div>
                        </div>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseFilterResults"></button>
                    </div>
                    <div class="modal-body">
                        @if (filteredTrucks.Count == 0)
                        {
                            <div class="alert alert-info mb-0">No trucks match all of the selected states. Try clearing one or more filters.</div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var matchingTruck in filteredTrucks)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                            <div>
                                                <div class="fw-bold"><span class="badge bg-dark me-2">@matchingTruck.TruckId</span>@matchingTruck.DriverName</div>
                                                <div class="small text-muted mt-1">@matchingTruck.NearestTown</div>
                                                <div class="small mt-2 d-flex flex-wrap gap-3">
                                                    <span>Fuel: <strong>@matchingTruck.FuelLevelLiters.ToString("F0") L · @GetFuelStatusLabel(matchingTruck.FuelLevelLiters)</strong></span>
                                                    <span>Oil: <strong>@GetOilLevelStatus(matchingTruck.TruckId)</strong></span>
                                                    <span>Tyres: <strong>@GetTyrePressureStatus(matchingTruck.TruckId)</strong></span>
                                                </div>
                                            </div>
                                            <button class="btn btn-outline-primary" @onclick="() => GoToTruckAsync(matchingTruck.TruckId)">Go to Truck</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseFilterResults">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (activeTruck.HasValue)
    {
        var truck = activeTruck.Value;

        
        <div class="card border-0 shadow-sm mb-4 bg-light">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-speedometer2 me-2"></i>Primary Flight & Telemetry Metrics</h5>
                <span class="badge bg-primary fs-6">Driver: @truck.DriverName</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 text-center">
                    <div class="col-md-3">
                        <div class="p-3 bg-white rounded shadow-sm border">
                            <div class="text-uppercase small text-muted fw-bold">Vehicle Speed</div>
                            <div class="display-6 fw-bold text-primary my-1">@truck.SpeedKmh.ToString("F1") <span class="fs-6">km/h</span></div>
                            <span class="badge @(truck.SpeedKmh > 0 ? "bg-success" : "bg-secondary")">
                                @(truck.SpeedKmh > 0 ? "In Transit" : "Stationary")
                            </span>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="p-3 bg-white rounded shadow-sm border">
                            <div class="text-uppercase small text-muted fw-bold">Distance Traveled</div>
                            <div class="display-6 fw-bold text-dark my-1">@truck.DistanceTraveledKm.ToString("N0") <span class="fs-6">km</span></div>
                            <span class="badge bg-info text-dark">Odometer Metric</span>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="p-3 bg-white rounded shadow-sm border">
                            <div class="text-uppercase small text-muted fw-bold">Remaining Fuel</div>
                            <div class="display-6 fw-bold @GetFuelTextColor(truck.FuelLevelLiters) my-1">
                                @truck.FuelLevelLiters.ToString("F0") <span class="fs-6">L</span>
                            </div>
                            <span class="badge @GetFuelBadgeColor(truck.FuelLevelLiters)">
                                @GetFuelStatusLabel(truck.FuelLevelLiters)
                            </span>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="p-3 bg-white rounded shadow-sm border">
                            <div class="text-uppercase small text-muted fw-bold">GPS Location</div>
                            <div class="fw-bold text-dark fs-5 mt-2 mb-1">@currentLat.ToString("F4"), @currentLng.ToString("F4")</div>
                            <div class="small text-truncate text-muted">@truck.NearestTown</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-primary shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="mb-0 fw-bold"><i class="bi bi-fuel-pump-fill me-2"></i>Predicted Remaining Fuel Range</h5>
                <button class="btn btn-sm btn-light text-primary fw-bold" @onclick="RefreshFuelRangePredictionAsync" disabled="@isPredictingFuelRange">
                    @(isPredictingFuelRange ? "Predicting..." : "Refresh prediction")
                </button>
            </div>
            <div class="card-body">
                @if (isPredictingFuelRange && fuelRangePrediction is null)
                {
                    <div class="text-muted" role="status">Calculating range estimate...</div>
                }
                else if (!string.IsNullOrEmpty(fuelPredictionError))
                {
                    <div class="alert alert-warning mb-0" role="alert">@fuelPredictionError</div>
                }
                else if (fuelRangePrediction is not null)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <div class="fw-bold">@truck.TruckId — @truck.DriverName</div>
                            @if (truck.SpeedKmh <= 0.5f)
                            {
                                <div class="small text-muted">Stationary — predicted remaining range is 0 km until the truck moves.</div>
                            }
                            else
                            {
                                <div class="small text-muted">Estimate based on speed, current fuel, and payload.</div>
                            }
                            <div class="small text-muted">Updated @fuelRangePrediction.PredictedAtUtc.ToLocalTime().ToString("t")</div>
                        </div>
                        <div class="display-5 fw-bold text-primary">@fuelRangePrediction.PredictedRemainingRangeKm.ToString("N0") <span class="fs-5">km</span></div>
                    </div>
                }
                else
                {
                    <div class="text-muted">No fuel range prediction is available yet.</div>
                }
            </div>
        </div>

        
        <h5 class="fw-bold mb-3"><i class="bi bi-shield-check me-2"></i>Critical Fluid & Safety Sensors</h5>
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase small text-muted fw-bold d-block">Engine Fluid Health</span>
                            <h4 class="fw-bold mb-0 mt-1">Oil Level Sensor</h4>
                        </div>
                        <div>
                            @if (IsOilLevelCorrect(truck.TruckId))
                            {
                                <span class="badge bg-success fs-5 px-4 py-2">Correct</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-5 px-4 py-2">Low</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase small text-muted fw-bold d-block">Chassis & Safety</span>
                            <h4 class="fw-bold mb-0 mt-1">Overall Tire Pressure (TPMS)</h4>
                        </div>
                        <div>
                            @if (IsTirePressureCorrect(truck.TruckId))
                            {
                                <span class="badge bg-success fs-5 px-4 py-2">Correct</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-5 px-4 py-2">Low</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="card border-0 shadow-sm opacity-75 mb-4">
            <div class="card-header bg-secondary text-white py-2">
                <h6 class="mb-0 fw-bold small text-uppercase">Components: Transponder & Hardware Nodes</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>GPS Transponder Module</strong>
                                <span class="badge bg-outline-dark border text-dark">Active Sync</span>
                            </div>
                            <div class="small text-muted mt-2">
                                MAC Identifier: <code>02:42:AC:11:00:@truck.TruckId[^2..]</code><br />
                                Protocol: NMEA 0183 / Satellite Uplink<br />
                                Signal Strength: -68 dBm (Optimal)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>ESP 32 Connectivity Microcontroller</strong>
                                <span class="badge bg-outline-dark border text-dark">Telemetry Bus</span>
                            </div>
                            <div class="small text-muted mt-2">
                                MAC Identifier: <code>24:6F:28:AB:C1:@truck.TruckId[^2..]</code><br />
                                Firmware: v2.4.1 (ESP-IDF Native)<br />
                                Bus Status: CAN-Bus 2.0B Nominal
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        //Live map and slider
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-geo-alt-fill me-2"></i>Live Geospatial Route & Historical Progression</h5>
                <span class="badge bg-light text-dark">@GetPlaybackLabel()</span>
            </div>
            <div class="card-body p-4">
                <!-- Historical Timeline Slider -->
                <div class="p-3 bg-light rounded border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="fw-bold text-dark">Telemetry Timeline Playback:</label>
                        <span class="fw-bold text-primary fs-5">
                            @(hoursAgo == 0 ? "LIVE (Current)" : $"{hoursAgo:F1} Hours Ago")
                        </span>
                    </div>
                    <input type="range" class="form-range" min="0" max="12" step="1" value="@hoursAgo" @oninput="OnTimelineSliderChanged" />
                    <div class="d-flex justify-content-between text-muted small fw-bold mt-1">
                        <span>NOW (Live)</span>
                        <span>3 Hours Ago</span>
                        <span>6 Hours Ago</span>
                        <span>9 Hours Ago</span>
                        <span class="text-success">12 Hours Ago</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(telemetryError))
                {
                    <div class="alert alert-warning" role="alert">@telemetryError</div>
                }

                <!-- Leaflet Map Container -->
                <div id="fleetDashboardMap" style="height: 420px; width: 100%; border-radius: 8px; z-index: 1;" class="border shadow-sm"></div>
            </div>
        </div>
    }
</div>

@code {
    private string selectedTruckId = "TRK-001";
    private TruckTelemetry? activeTruck;
    private double hoursAgo = 0;
    private double currentLat;
    private double currentLng;
    private List<TelemetryPacket<TruckTelemetry>> telemetryHistory = new();
    private string? telemetryError;
    private bool hasGpsLocation;
    private List<FleetAlert> emergencyAlerts = new();
    private bool isEmergencyFeedExpanded = true;
    private string? alertFeedError;
    private CancellationTokenSource? alertPollingCancellation;
    private Task? alertPollingTask;
    private FuelRangePrediction? fuelRangePrediction;
    private string? fuelPredictionError;
    private bool isPredictingFuelRange;
    private long fuelPredictionRequestNumber;
    private string fuelFilter = "Any";
    private string oilFilter = "Any";
    private string tyreFilter = "Any";
    private bool showFilterResults;

    protected override async Task OnInitializedAsync()
    {
        UpdateActiveTruck();

        try
        {
            var routeSamples = TruckRouteSimulator.GenerateHourlySamples(SensorService.Fleet);
            if (!await ApiClient.SendTelemetryBatchAsync(routeSamples))
            {
                telemetryError = "The telemetry API did not accept the simulated GPS data.";
            }
            else
            {
                await LoadTruckHistoryAsync();
            }
        }
        catch (HttpRequestException)
        {
            telemetryError = "Unable to reach the telemetry API. GPS playback requires the server to be running.";
        }

        await RefreshFuelRangePredictionAsync();
        await RefreshEmergencyAlertsAsync();
        alertPollingCancellation = new CancellationTokenSource();
        alertPollingTask = PollEmergencyAlertsAsync(alertPollingCancellation.Token);
    }

    private async Task PollEmergencyAlertsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshEmergencyAlertsAsync(cancellationToken);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshEmergencyAlertsAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            emergencyAlerts = await ApiClient.GetEmergencyAlertsAsync(cancellationToken) ?? new();
            alertFeedError = null;
        }
        catch (HttpRequestException)
        {
            alertFeedError = "Unable to refresh emergency alerts from the telemetry API.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (activeTruck.HasValue && hasGpsLocation)
        {
            await RenderMapAsync();
        }
    }

    private async Task OnTruckSelected(ChangeEventArgs e)
    {
        selectedTruckId = e.Value?.ToString() ?? "TRK-001";
        hoursAgo = 0; // Reset timeline on truck change
        UpdateActiveTruck();
        await LoadTruckHistoryAsync();
        await RefreshFuelRangePredictionAsync();
    }

    private async Task RefreshFuelRangePredictionAsync()
    {
        if (!activeTruck.HasValue)
        {
            return;
        }

        var truck = activeTruck.Value;
        var requestNumber = ++fuelPredictionRequestNumber;
        isPredictingFuelRange = true;
        fuelPredictionError = null;

        try
        {
            var prediction = await ApiClient.PredictFuelRangeAsync(truck);
            if (requestNumber == fuelPredictionRequestNumber)
            {
                fuelRangePrediction = prediction;
                if (prediction is null)
                {
                    fuelPredictionError = "The API returned no fuel range prediction.";
                }
            }
        }
        catch (HttpRequestException)
        {
            if (requestNumber == fuelPredictionRequestNumber)
            {
                fuelRangePrediction = null;
                fuelPredictionError = "Unable to get a fuel range prediction from the server.";
            }
        }
        finally
        {
            if (requestNumber == fuelPredictionRequestNumber)
            {
                isPredictingFuelRange = false;
            }
        }
    }

    private async Task OnTimelineSliderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var parsedValue))
        {
            hoursAgo = parsedValue;
            SetCurrentGpsLocation();
            await RenderMapAsync();
        }
    }

    private void UpdateActiveTruck()
    {
        if (SensorService.Fleet.Any(t => t.TruckId == selectedTruckId))
        {
            activeTruck = SensorService.Fleet.First(t => t.TruckId == selectedTruckId);
        }
        else if (SensorService.Fleet.Any())
        {
            activeTruck = SensorService.Fleet.First();
        }
        else
        {
            activeTruck = null;
        }

        SetCurrentGpsLocation();
    }

    private async Task LoadTruckHistoryAsync()
    {
        telemetryHistory.Clear();
        hasGpsLocation = false;
        telemetryError = null;
        if (!activeTruck.HasValue) return;

        try
        {
            telemetryHistory = await ApiClient.GetTelemetryHistoryAsync(activeTruck.Value.TruckId) ?? new();
            if (telemetryHistory.Count == 0)
            {
                telemetryError = "No GPS history is available for this truck from the telemetry API.";
                return;
            }

            SetCurrentGpsLocation();
        }
        catch (HttpRequestException)
        {
            telemetryError = "Unable to retrieve GPS history from the telemetry API.";
        }
    }

    private void SetCurrentGpsLocation()
    {
        if (telemetryHistory.Count == 0)
        {
            hasGpsLocation = false;
            return;
        }

        var history = telemetryHistory.OrderByDescending(packet => packet.Timestamp).ToArray();
        var readingIndex = Math.Min((int)Math.Round(hoursAgo), history.Length - 1);
        var telemetry = history[readingIndex].Payload;
        currentLat = telemetry.Latitude;
        currentLng = telemetry.Longitude;
        hasGpsLocation = true;
    }

    private async Task RenderMapAsync()
    {
        if (!activeTruck.HasValue || !hasGpsLocation) return;

        try
        {
            var routeCoordinates = telemetryHistory
                .OrderBy(packet => packet.Timestamp)
                .Select(packet => new[] { packet.Payload.Latitude, packet.Payload.Longitude })
                .ToArray();
            await JSRuntime.InvokeVoidAsync(
                "updateFleetMap",
                "fleetDashboardMap",
                currentLat,
                currentLng,
                activeTruck.Value.TruckId,
                activeTruck.Value.DriverName,
                hoursAgo,
                routeCoordinates
            );
        }
        catch
        {
            // Fallback gracefully during prerendering or initial script load
        }
    }

    private string GetPlaybackLabel()
    {
        if (hoursAgo == 0) return "Mode: Real-Time Stream";
        return $"Playback: -{hoursAgo:F1}h Historical Buffer";
    }

    private string GetFuelBadgeColor(float fuel) => fuel switch
    {
        > 300f => "bg-success",
        <= 100f => "bg-danger",
        _ => "bg-warning text-dark"
    };

    private string GetFuelTextColor(float fuel) => fuel switch
    {
        > 300f => "text-success",
        <= 100f => "text-danger fw-bold",
        _ => "text-warning"
    };

    private string GetFuelStatusLabel(float fuel) => fuel switch
    {
        > 300f => "Optimal Level",
        <= 100f => "CRITICAL LOW FUEL",
        _ => "Moderate Level"
    };

    private bool IsOilLevelCorrect(string truckId) => !SensorService.Fleet.FirstOrDefault(truck => truck.TruckId == truckId).OilLevelLow;
    private bool IsTirePressureCorrect(string truckId) => !SensorService.Fleet.FirstOrDefault(truck => truck.TruckId == truckId).TyrePressureLow;

    private static string GetAlertTypeDisplay(FleetAlertType alertType) => alertType switch
    {
        FleetAlertType.FuelLow => "Low fuel",
        FleetAlertType.OilLevelLow => "Low oil level",
        FleetAlertType.TyrePressureLow => "Low tyre pressure",
        _ => "Vehicle alert"
    };

    private void ToggleEmergencyFeed() => isEmergencyFeedExpanded = !isEmergencyFeedExpanded;

    private string GetFuelFilterState(float fuel) => fuel switch
    {
        > 300f => "Optimal",
        <= 100f => "Low",
        _ => "Moderate"
    };

    private string GetOilLevelStatus(string truckId) => IsOilLevelCorrect(truckId) ? "Correct" : "Low";

    private string GetTyrePressureStatus(string truckId) => IsTirePressureCorrect(truckId) ? "Correct" : "Low";

    private List<TruckTelemetry> GetFilteredTrucks() => SensorService.Fleet
        .Where(truck => fuelFilter == "Any" || GetFuelFilterState(truck.FuelLevelLiters) == fuelFilter)
        .Where(truck => oilFilter == "Any" || GetOilLevelStatus(truck.TruckId) == oilFilter)
        .Where(truck => tyreFilter == "Any" || GetTyrePressureStatus(truck.TruckId) == tyreFilter)
        .ToList();

    private void ShowFilteredTrucks() => showFilterResults = true;

    private void CloseFilterResults() => showFilterResults = false;

    private void ClearFilters()
    {
        fuelFilter = "Any";
        oilFilter = "Any";
        tyreFilter = "Any";
    }

    private Task GoToTruckAsync(string truckId)
    {
        showFilterResults = false;
        return OnTruckSelected(new ChangeEventArgs { Value = truckId });
    }

    public async ValueTask DisposeAsync()
    {
        if (alertPollingCancellation is null)
        {
            return;
        }

        alertPollingCancellation.Cancel();
        if (alertPollingTask is not null)
        {
            await alertPollingTask;
        }

        alertPollingCancellation.Dispose();
    }
}